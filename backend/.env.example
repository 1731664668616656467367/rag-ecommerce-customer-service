# ---------- 应用 ----------
APP_NAME=电商智能客服 RAG
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# 前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- 数据库 ----------
# 默认 SQLite，文件在 backend/data/app.db
# DATABASE_URL=sqlite:///D:/电商系统/backend/data/app.db

# ---------- DeepSeek ----------
# 必填，否则聊天只能走“仅检索降级模式”
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# ---------- Embedding ----------
# auto: 先探测 Ollama，连不上自动降级到本地哈希向量
# ollama: 强制使用 Ollama（连不上也会降级，并打印警告）
# local: 强制使用本地哈希向量（无需任何外部服务）
EMBEDDING_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=4096

# ---------- RAG ----------
CHUNK_SIZE=320
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=4
# 0 表示按 embedding 类型自动选阈值；固定值需自行校准
RETRIEVAL_MIN_SCORE=0

# ---------- 上传 ----------
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx

# ---------- 会话 ----------
MAX_MESSAGE_CHARS=2000
HISTORY_WINDOW=8
