# ---------- 应用 ----------
APP_NAME=电商智能客服 RAG
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# 前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- 数据库 ----------
# 默认 SQLite，文件在 backend/data/app.db
# DATABASE_URL=sqlite:///D:/电商系统/backend/data/app.db

# ---------- 回答模式 ----------
# knowledge_only：只用本地规则 + 知识库检索回答，绝不发起任何外部模型请求（默认）
# llm：显式开启大模型生成。必须手动改成 llm，不会因为存在 API Key 就自动启用
ANSWER_MODE=knowledge_only

# ---------- 检索方式 ----------
# hybrid：向量 + BM25 融合（默认）| vector：仅向量 | lexical：仅 BM25
RETRIEVAL_MODE=hybrid

# ---------- DeepSeek（仅在 ANSWER_MODE=llm 时才会被使用）----------
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# ---------- Embedding ----------
# auto: 先探测 Ollama，连不上自动降级到本地哈希向量
# ollama: 强制使用 Ollama（连不上也会降级，并打印警告）
# local: 强制使用本地哈希向量（无需任何外部服务）
EMBEDDING_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=4096

# ---------- RAG ----------
CHUNK_SIZE=320
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=4
# 0 表示按 embedding 类型自动选阈值；固定值需自行校准
RETRIEVAL_MIN_SCORE=0
# 词法通道（BM25 / 本地哈希向量）的最低加权覆盖度。
# 调高 = 更保守（宁可说“没找到”也不搬错段落）；调低 = 召回更多但误答风险上升。
# 默认值按当前知识库实测校准，换语料后请重跑 scripts/eval_retrieval.py
RETRIEVAL_MIN_COVERAGE=0.12

# ---------- 上传 ----------
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx

# ---------- 会话 ----------
MAX_MESSAGE_CHARS=2000
HISTORY_WINDOW=8
